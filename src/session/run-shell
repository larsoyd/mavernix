#!/usr/bin/env bash
# Starts the shell with the current desktop's environment, so a shell
# restarted after a desktop switch gets the new one. Run by the compositor
# through keep-running.
set -euo pipefail

# shellcheck source=paths.sh.in
source "$(dirname "$(readlink -f "$0")")/paths.sh"
state_dir=$(dirname "${DESKTOP_SHELL_SETTINGS:?run-shell: DESKTOP_SHELL_SETTINGS is not set; start-desktop sets it}")

# shellcheck source=/dev/null
source "$state_dir/desktop.env"

# `exec` keeps this pid for the shell, so a switch can signal it. Wayfire
# ignores SIGHUP and its children inherit that; bash cannot undo an ignore it
# was started with, so env restores the default, or the shell would never end.
# Quickshell's crash handler restarts in place while the dying copy still holds
# the bus, and the new shell loses its names. keep-running restarts it cleanly.
# a full runtime dir must not stop the shell, only a switch needs this
echo $$ > "$state_dir/shell.pid" || echo "run-shell: could not write shell.pid" >&2
exec env --default-signal=HUP QS_DISABLE_CRASH_HANDLER=1 qs -p "$shell_dir"
