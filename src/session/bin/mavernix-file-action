#!/bin/sh
# File actions `gio` cannot do in one call, named by the desktop config's
# [desktop_files] table.
#
#   mavernix-file-action new-folder FOLDER NAME    a folder NAME in FOLDER ("NAME 2" if taken)
#   mavernix-file-action move-into FOLDER FILE...  move the files into FOLDER ("letter 2.txt" if taken)
#   mavernix-file-action duplicate FILE...         a copy beside each file ("letter copy.txt")
#   mavernix-file-action shortcut FOLDER ID [NAME [ICON]]
#                                                  a launcher in FOLDER for the program with desktop entry ID,
#                                                  under NAME and with ICON if the user chose their own
set -eu

# A path in FOLDER for NAME + EXTENSION that is not taken yet: NAME, then
# "NAME 2", "NAME 3" and so on.
free_path() {
    folder=$1 name=$2 extension=$3
    candidate="$folder/$name$extension"
    number=2
    while [ -e "$candidate" ]; do
        candidate="$folder/$name $number$extension"
        number=$((number + 1))
    done
    printf '%s\n' "$candidate"
}

# FILE's name split into base and extension, so the extension stays last
# ("letter copy.txt"); folders and dotfiles have none.
split_name() {
    name=$(basename "$1")
    base=$name
    extension=""
    stem=${name%.*}
    if [ ! -d "$1" ] && [ "$stem" != "$name" ] && [ -n "$stem" ]; then
        base=$stem
        extension=.${name##*.}
    fi
}

# the desktop entry file of program ID, the user's own before the system's
entry_file() {
    folders="${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    while [ -n "$folders" ]; do
        candidate="${folders%%:*}/applications/$1.desktop"
        if [ -f "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
        case "$folders" in
        *:*) folders=${folders#*:} ;;
        *) folders="" ;;
        esac
    done
    return 1
}

action=${1:-}
[ $# -gt 0 ] && shift
case "$action" in
new-folder)
    [ $# -eq 2 ] || { echo "usage: mavernix-file-action new-folder FOLDER NAME" >&2; exit 2; }
    gio mkdir "$(free_path "$1" "$2" "")"
    ;;
move-into)
    [ $# -ge 2 ] || { echo "usage: mavernix-file-action move-into FOLDER FILE..." >&2; exit 2; }
    folder=$1
    shift
    for file in "$@"; do
        # Already in FOLDER: nothing to move.
        [ "$file" -ef "$folder/$(basename "$file")" ] && continue
        # A free name, as gio move would replace a file of the same name.
        split_name "$file"
        gio move "$file" "$(free_path "$folder" "$base" "$extension")"
    done
    ;;
duplicate)
    [ $# -ge 1 ] || { echo "usage: mavernix-file-action duplicate FILE..." >&2; exit 2; }
    for file in "$@"; do
        folder=$(dirname "$file")
        split_name "$file"
        # cp, not gio copy: gio cannot copy a folder.
        cp -a "$file" "$(free_path "$folder" "$base copy" "$extension")"
    done
    ;;
shortcut)
    [ $# -ge 2 ] && [ $# -le 4 ] || { echo "usage: mavernix-file-action shortcut FOLDER ID [NAME [ICON]]" >&2; exit 2; }
    entry=$(entry_file "$2") || { echo "mavernix-file-action: no desktop entry for $2" >&2; exit 1; }
    name=${3:-}
    [ -n "$name" ] || name=$(sed -n 's/^Name=//p' "$entry" | head -n 1)
    [ -n "$name" ] || name=$2
    mkdir -p "$1"
    launcher=$(free_path "$1" "$(printf '%s' "$name" | tr / -)" .desktop)
    # a chosen name and icon replace the program's own, not those of its actions
    WANTED_NAME=${3:-} WANTED_ICON=${4:-} awk '
        /^\[/ { in_entry = ($0 == "[Desktop Entry]") }
        in_entry && /^Name=/ && ENVIRON["WANTED_NAME"] != "" { print "Name=" ENVIRON["WANTED_NAME"]; next }
        in_entry && /^Icon=/ && ENVIRON["WANTED_ICON"] != "" { print "Icon=" ENVIRON["WANTED_ICON"]; next }
        { print }' "$entry" > "$launcher"
    # executable, so the desktop takes it as a trusted launcher
    chmod 755 "$launcher"
    ;;
*)
    echo "usage: mavernix-file-action new-folder|move-into|duplicate|shortcut ..." >&2
    exit 2
    ;;
esac
