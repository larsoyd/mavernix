# Draws the part of a window that reaches onto another screen.

shared_module(
    'across-screens',
    ['across-screens.cpp'],
    dependencies: [wayfire],
    cpp_args: wayfire_plugin_args,
    install: true,
    install_dir: wayfire_plugin_dir,
)
install_data('metadata/across-screens.xml', install_dir: wayfire_metadata_dir)
